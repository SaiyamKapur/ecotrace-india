# Required: PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: live multimodal chat/vision through OpenRouter. Leave blank for guided/demo fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Course evaluation only. Remove/disable for a real public deployment.
ECOTRACE_SAMPLE_ACCESS=enabled
